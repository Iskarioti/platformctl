{
  "id": "tempo",
  "compose": "compose.yaml",
  "versions": "versions.env",
  "defaults": "defaults.env",
  "secrets": null,
  "secretKeys": [],
  "dependsOn": [],
  "volumes": [
    "platform-tempo-data"
  ],
  "hostEndpoints": [
    {
      "label": "Tempo",
      "endpoint": "http://127.0.0.1:${TEMPO_HOST_PORT}"
    }
  ],
  "dockerEndpoints": [
    {
      "label": "Tempo query",
      "endpoint": "dev-tempo:3200"
    },
    {
      "label": "Tempo OTLP gRPC (internal only)",
      "endpoint": "dev-tempo:4317"
    }
  ]
}
