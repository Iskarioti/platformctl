{
  "id": "langfuse",
  "compose": "compose.yaml",
  "versions": "versions.env",
  "defaults": "defaults.env",
  "secrets": "~/.config/workstation/services/langfuse.env",
  "secretKeys": [
    "LANGFUSE_SALT",
    "LANGFUSE_ENCRYPTION_KEY",
    "LANGFUSE_NEXTAUTH_SECRET",
    "LANGFUSE_INIT_USER_PASSWORD",
    "LANGFUSE_INIT_PROJECT_PUBLIC_KEY",
    "LANGFUSE_INIT_PROJECT_SECRET_KEY"
  ],
  "dependsOn": [
    "postgres",
    "redis",
    "clickhouse",
    "garage"
  ],
  "consumes": {
    "LANGFUSE_DB_INIT_IMAGE": "postgres:POSTGRES_IMAGE",
    "LANGFUSE_DB_INIT_VERSION": "postgres:POSTGRES_VERSION",
    "LANGFUSE_DB_USER": "postgres:POSTGRES_USER",
    "LANGFUSE_DB_PASSWORD": "postgres:POSTGRES_PASSWORD",
    "LANGFUSE_CACHE_PASSWORD": "redis:REDIS_PASSWORD",
    "LANGFUSE_ANALYTICS_INIT_IMAGE": "clickhouse:CLICKHOUSE_IMAGE",
    "LANGFUSE_ANALYTICS_INIT_VERSION": "clickhouse:CLICKHOUSE_VERSION",
    "LANGFUSE_ANALYTICS_USER": "clickhouse:CLICKHOUSE_USER",
    "LANGFUSE_ANALYTICS_PASSWORD": "clickhouse:CLICKHOUSE_PASSWORD",
    "LANGFUSE_STORAGE_ACCESS_KEY": "garage:GARAGE_ACCESS_KEY",
    "LANGFUSE_STORAGE_SECRET_KEY": "garage:GARAGE_SECRET_KEY",
    "LANGFUSE_STORAGE_BUCKET": "garage:GARAGE_DEFAULT_BUCKET"
  },
  "volumes": [],
  "hostEndpoints": [
    {
      "label": "Langfuse",
      "endpoint": "http://127.0.0.1:${LANGFUSE_HOST_PORT}"
    }
  ],
  "dockerEndpoints": [
    {
      "label": "Langfuse",
      "endpoint": "dev-langfuse:3000"
    }
  ]
}
