# All secrets below are generated automatically by
# "workstation services up langfuse" via generate_secret_file, and stored at
# ~/.config/workstation/services/langfuse.env - never commit real values.
LANGFUSE_POSTGRES_PASSWORD=change-me
LANGFUSE_CLICKHOUSE_PASSWORD=change-me
LANGFUSE_REDIS_AUTH=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_GARAGE_RPC_SECRET=change-me
LANGFUSE_GARAGE_ADMIN_TOKEN=change-me
LANGFUSE_GARAGE_S3_ACCESS_KEY=change-me
LANGFUSE_GARAGE_S3_SECRET_KEY=change-me

# Pre-seeded on first boot (LANGFUSE_INIT_*): a local admin account and a
# default project with its own API keys, so project templates can start
# sending traces immediately without a manual sign-up step in the UI.
LANGFUSE_INIT_USER_PASSWORD=change-me
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=change-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=change-me
