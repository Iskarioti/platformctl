{
  "id": "minio",
  "compose": "compose.yaml",
  "versions": "versions.env",
  "defaults": "defaults.env",
  "secrets": "~/.config/workstation/services/minio.env",
  "secretKeys": [
    "MINIO_ROOT_PASSWORD"
  ],
  "dependsOn": [],
  "volumes": [
    "platform-minio-data"
  ],
  "hostEndpoints": [
    {
      "label": "MinIO API",
      "endpoint": "http://127.0.0.1:${MINIO_API_HOST_PORT}"
    },
    {
      "label": "MinIO UI",
      "endpoint": "http://127.0.0.1:${MINIO_CONSOLE_HOST_PORT}"
    }
  ],
  "dockerEndpoints": [
    {
      "label": "MinIO",
      "endpoint": "dev-minio:9000"
    }
  ]
}
