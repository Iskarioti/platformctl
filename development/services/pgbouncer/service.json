{
  "id": "pgbouncer",
  "compose": "compose.yaml",
  "versions": "versions.env",
  "defaults": "defaults.env",
  "secrets": null,
  "secretKeys": [],
  "dependsOn": [
    "postgres"
  ],
  "volumes": [],
  "hostEndpoints": [
    {
      "label": "PgBouncer",
      "endpoint": "postgresql://${POSTGRES_USER}@127.0.0.1:${PGBOUNCER_HOST_PORT}/${POSTGRES_DB}"
    }
  ],
  "dockerEndpoints": [
    {
      "label": "PgBouncer",
      "endpoint": "dev-pgbouncer:5432"
    }
  ]
}
