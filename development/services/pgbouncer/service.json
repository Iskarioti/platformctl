{
  "id": "pgbouncer",
  "compose": "compose.yaml",
  "versions": "versions.env",
  "defaults": "defaults.env",
  "secrets": null,
  "secretKeys": [],
  "dependsOn": [
    "postgres"
  ],
  "consumes": {
    "PGBOUNCER_DB_USER": "postgres:POSTGRES_USER",
    "PGBOUNCER_DB_PASSWORD": "postgres:POSTGRES_PASSWORD",
    "PGBOUNCER_DB_NAME": "postgres:POSTGRES_DB"
  },
  "volumes": [],
  "hostEndpoints": [
    {
      "label": "PgBouncer",
      "endpoint": "postgresql://${PGBOUNCER_DB_USER}@127.0.0.1:${PGBOUNCER_HOST_PORT}/${PGBOUNCER_DB_NAME}"
    }
  ],
  "dockerEndpoints": [
    {
      "label": "PgBouncer",
      "endpoint": "dev-pgbouncer:5432"
    }
  ]
}
