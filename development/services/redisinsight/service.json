{
  "id": "redisinsight",
  "compose": "compose.yaml",
  "versions": "versions.env",
  "defaults": "defaults.env",
  "secrets": "~/.config/workstation/services/redisinsight.env",
  "secretKeys": [
    "REDISINSIGHT_ENCRYPTION_KEY"
  ],
  "dependsOn": [
    "redis"
  ],
  "consumes": {
    "REDISINSIGHT_REDIS_PASSWORD": "redis:REDIS_PASSWORD"
  },
  "volumes": [
    "platform-redisinsight-data"
  ],
  "hostEndpoints": [
    {
      "label": "Redis Insight",
      "endpoint": "http://127.0.0.1:${REDISINSIGHT_HOST_PORT}"
    }
  ],
  "dockerEndpoints": [
    {
      "label": "Redis Insight",
      "endpoint": "dev-redisinsight:5540"
    }
  ]
}
