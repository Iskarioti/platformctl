# Pinned development service images. Update deliberately via Git review.
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=17.11-bookworm

REDIS_IMAGE=redis
REDIS_VERSION=7.4.11-bookworm

KAFKA_IMAGE=apache/kafka
KAFKA_VERSION=4.3.1

OPENSEARCH_IMAGE=opensearchproject/opensearch
OPENSEARCH_VERSION=3.8.0

RABBITMQ_IMAGE=rabbitmq
RABBITMQ_VERSION=4.1.8-management

MONGODB_IMAGE=mongo
MONGODB_VERSION=8.0.29-noble

PGBOUNCER_IMAGE=edoburu/pgbouncer
PGBOUNCER_VERSION=v1.24.0-p1

MAILPIT_IMAGE=axllent/mailpit
MAILPIT_VERSION=v1.30.0

# Optional S3-compatible object storage for local development.
# Keep this on the legacy community MinIO image line unless licensing/product
# policy is deliberately reviewed before moving to AIStor images.
MINIO_IMAGE=quay.io/minio/minio
MINIO_VERSION=RELEASE.2025-07-23T15-54-02Z
