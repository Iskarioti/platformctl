{
  "$schema": "../schema/development-policy.schema.json",
  "version": "1.2.1",
  "projectRoots": [
    "~/src/company",
    "~/src/platform",
    "~/src/automation",
    "~/src/labs",
    "~/src/tooling"
  ],
  "windows": {
    "developmentInWSL": true,
    "wslDistribution": "Ubuntu-24.04",
    "dockerEngine": "wsl",
    "dockerDesktopAllowed": false,
    "allowProjectsOnWindowsFilesystem": false
  },
  "projects": {
    "requireGit": true,
    "requireDevContainer": true,
    "requireEditorConfig": true,
    "requireGitignore": true,
    "requireReadme": true,
    "requireEnvExample": true,
    "requirePlatformMetadata": true,
    "lockfilePolicy": "warn",
    "allowedTemplates": [
      "fastapi-service",
      "react-app",
      "python-service",
      "terraform",
      "research-python",
      "mcp-server",
      "rag-app",
      "agent-app"
    ]
  },
  "git": {
    "defaultBranch": "main",
    "directPushToMain": false,
    "forcePush": false,
    "requirePullRequest": true,
    "requireStatusChecks": true
  },
  "security": {
    "forbidTrackedEnvFiles": true,
    "forbidPrivateKeys": true,
    "forbidSecrets": true,
    "requireDependencyScanning": true,
    "requireSecretScanning": true
  },
  "containers": {
    "requireNonRootDevContainer": true,
    "forbidLatestTag": true,
    "publishPortsToLocalhostByDefault": true
  },
  "developmentServices": {
    "enabled": true,
    "catalog": "development/catalog.json",
    "network": "platform-dev",
    "credentialsFile": "~/.config/workstation/services",
    "autoStartAfterBootstrap": false,
    "allowedServices": [
      "postgres",
      "pgbouncer",
      "pgadmin",
      "redis",
      "redisinsight",
      "kafka",
      "kafbat-ui",
      "opensearch",
      "opensearch-dashboards",
      "rabbitmq",
      "mongodb",
      "minio",
      "mailpit",
      "dev-dashboard",
      "otel-collector",
      "prometheus",
      "loki",
      "tempo",
      "grafana",
      "cadvisor",
      "node-exporter",
      "qdrant",
      "open-webui",
      "langfuse",
      "clickhouse",
      "garage"
    ],
    "profiles": {
      "core": ["postgres", "redis"],
      "messaging": ["kafka", "rabbitmq"],
      "search": ["opensearch"],
      "data": ["postgres", "pgbouncer", "mongodb"],
      "integration": ["minio", "mailpit"],
      "ui": ["dev-dashboard", "pgadmin", "redisinsight", "kafbat-ui", "opensearch-dashboards"],
      "observability": ["otel-collector", "prometheus", "loki", "tempo", "grafana", "cadvisor", "node-exporter"],
      "ai": ["qdrant", "open-webui", "langfuse"],
      "all": [
        "postgres",
        "pgbouncer",
        "pgadmin",
        "redis",
        "redisinsight",
        "kafka",
        "kafbat-ui",
        "opensearch",
        "opensearch-dashboards",
        "rabbitmq",
        "mongodb",
        "minio",
        "mailpit",
        "dev-dashboard",
        "otel-collector",
        "prometheus",
        "loki",
        "tempo",
        "grafana",
        "cadvisor",
        "node-exporter",
        "qdrant",
        "open-webui",
        "langfuse",
        "clickhouse",
        "garage"
      ]
    }
  },
  "labs": {
    "enabled": true,
    "catalog": "labs/catalog.json",
    "stateRoot": "~/.local/state/platformctl/labs",
    "defaultRuntime": "docker",
    "kubernetesProvider": "k3d",
    "kubernetesCluster": "platform-labs",
    "productionPromotion": "iac-only"
  },
  "ci": {
    "required": true,
    "authority": "github",
    "localHooksAreAdvisory": true
  }
}
