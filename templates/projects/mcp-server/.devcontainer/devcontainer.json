{
  "name": "__PROJECT_NAME__",
  "build": {"dockerfile":"Dockerfile","context":".."},
  "remoteUser": "vscode",
  "runArgs": ["--network=platform-dev"],
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "postCreateCommand": "python -m pip install -r requirements-dev.txt",
  "mounts": ["source=${localEnv:HOME}/.ssh/agent.sock,target=/ssh-agent,type=bind", "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly"],
  "containerEnv": {"SSH_AUTH_SOCK": "/ssh-agent"},
  "customizations": {"vscode":{"extensions":["ms-python.python","ms-python.vscode-pylance","charliermarsh.ruff"]}}
}
