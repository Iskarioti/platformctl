APP_ENV=development
APP_PORT=8000

# Non-secret: model-runtime hostname, already set as a containerEnv default in
# .devcontainer/devcontainer.json - override here only if different.
OLLAMA_BASE_URL=http://ollama:11434
CHAT_MODEL=gemma3:4b
LANGFUSE_HOST=http://dev-langfuse:3000

# Optional: copy the real values from ~/.config/workstation/services/langfuse.env
# (generated by "workstation services up langfuse") to enable LLM call tracing.
# Leave blank to run without Langfuse - the app works fine either way.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
