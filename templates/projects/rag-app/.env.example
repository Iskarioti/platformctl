APP_ENV=development
APP_PORT=8000

# Non-secret: dev-service/model-runtime hostnames, already set as containerEnv
# defaults in .devcontainer/devcontainer.json - override here only if different.
OLLAMA_BASE_URL=http://ollama:11434
QDRANT_URL=http://dev-qdrant:6333
LANGFUSE_HOST=http://dev-langfuse:3000

# Secret: copy the real value from ~/.config/workstation/services/qdrant.env
# (generated by "workstation services up qdrant") - never commit the real value.
QDRANT_API_KEY=

# Optional: copy the real values from ~/.config/workstation/services/langfuse.env
# (generated by "workstation services up langfuse") to enable LLM call tracing.
# Leave blank to run without Langfuse - the app works fine either way.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
