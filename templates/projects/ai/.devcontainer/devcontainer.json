{
  "name": "ai-platform-lab",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8000],
  "mounts": [
    "source=${localEnv:HOME}/.ssh/agent.sock,target=/ssh-agent,type=bind"
  ],
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
