{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ .Folder }} :: {{ .Shell }}",
  "terminal_background": "p:main-bg",
  "palette": {
    "main-bg": "#24283b",
    "red": "#f7768e",
    "green": "#9ece6a",
    "yellow": "#e0af68",
    "blue": "#7aa2f7",
    "cyan": "#7dcfff",
    "white": "#c0caf5",
    "muted": "#565f89",
    "magenta": "#bb9af7",
    "orange": "#ff9e64"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:blue",
          "template": "{{ if .WSL }}󰕈 {{ else }}{{ .Icon }} {{ end }}",
          "options": {
            "windows": "󰍲",
            "ubuntu": "󰕈",
            "linux": "󰌽",
            "macos": "󰀵",
            "debian": "󰣚",
            "fedora": "󰣛",
            "redhat": "󱄛",
            "redhatenterprise": "󱄛",
            "centos": "",
            "arch": "󰣇",
            "alpine": ""
          }
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:blue",
          "template": "<b>{{ .Path }}</b>{{ if not .Writable }} {{ end }} ",
          "options": {
            "style": "agnoster_short",
            "max_depth": 2,
            "hide_root_location": true,
            "folder_icon": "…",
            "folder_separator_icon": "/",
            "home_icon": "~"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:magenta",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if gt .Ahead 0 }}p:blue{{ end }}",
            "{{ if gt .Behind 0 }}p:cyan{{ end }}"
          ],
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if or (.Working.Changed) (.Staging.Changed) }} *{{ end }} ",
          "options": {
            "fetch_status": true,
            "native_status": true,
            "branch_icon": ""
          },
          "timeout": 500
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:yellow",
          "template": " {{ .Full }} ",
          "options": {
            "display_mode": "files"
          },
          "timeout": 300
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:green",
          "template": " {{ .Full }} ",
          "options": {
            "display_mode": "files"
          },
          "timeout": 300
        },
        {
          "type": "terraform",
          "style": "plain",
          "foreground": "p:magenta",
          "template": "󱁢 {{ .WorkspaceName }} ",
          "options": {
            "fetch_version": false
          },
          "timeout": 300
        },
        {
          "type": "docker",
          "style": "plain",
          "foreground": "p:blue",
          "template": " {{ .Context }} ",
          "options": {
            "display_mode": "files",
            "fetch_context": true
          },
          "timeout": 300
        },
        {
          "type": "kubectl",
          "style": "plain",
          "foreground": "p:blue",
          "foreground_templates": [
            "{{ if or (contains \"prod\" .Context) (contains \"production\" .Context) }}p:red{{ end }}"
          ],
          "template": "󱃾 {{ .Context }}{{ if .Namespace }}:{{ .Namespace }}{{ end }} ",
          "options": {
            "parse_kubeconfig": true,
            "display_error": false
          },
          "timeout": 300
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:red",
          "template": "{{ if ne .Code 0 }}✘{{ .Code }} {{ end }}",
          "options": {
            "always_enabled": true
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": ["{{ if ne .Code 0 }}p:red{{ end }}"],
          "template": "❯ "
        }
      ]
    },
    {
      "type": "rprompt",
      "overflow": "hide",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:yellow",
          "template": "󰔛 {{ .FormattedMs }} ",
          "options": {
            "threshold": 1000,
            "style": "austin"
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:muted",
          "template": " {{ .CurrentDate | date .Format }}",
          "options": {
            "time_format": "15:04"
          }
        }
      ]
    }
  ],
  "secondary_prompt": {
    "foreground": "p:blue",
    "background": "transparent",
    "template": "❯❯ "
  }
}
