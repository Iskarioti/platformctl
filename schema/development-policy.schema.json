{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platformctl Development Policy",
  "type": "object",
  "required": [
    "version",
    "projectRoots",
    "windows",
    "projects",
    "git",
    "security",
    "containers",
    "ci"
  ],
  "properties": {
    "version": { "type": "string" },
    "projectRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "windows": {
      "type": "object",
      "required": [
        "developmentInWSL",
        "wslDistribution",
        "dockerEngine",
        "dockerDesktopAllowed",
        "allowProjectsOnWindowsFilesystem"
      ]
    },
    "projects": {
      "type": "object",
      "required": ["requireGit", "requireDevContainer", "allowedTemplates"]
    },
    "git": { "type": "object" },
    "security": { "type": "object" },
    "containers": { "type": "object" },
    "ci": { "type": "object" }
  }
}
