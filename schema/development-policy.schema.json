{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "platformctl Development Policy",
  "type": "object",
  "required": ["version", "projectRoots", "windows", "projects", "security", "containers", "developmentServices", "ci"],
  "properties": {
    "version": {"type": "string"},
    "projectRoots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "windows": {"type": "object"},
    "projects": {"type": "object"},
    "git": {"type": "object"},
    "security": {"type": "object"},
    "containers": {"type": "object"},
    "developmentServices": {
      "type": "object",
      "required": ["enabled", "catalog", "network", "credentialsFile", "autoStartAfterBootstrap", "allowedServices", "profiles"],
      "properties": {
        "enabled": {"type": "boolean"},
        "catalog": {"type": "string"},
        "network": {"type": "string"},
        "credentialsFile": {"type": "string"},
        "autoStartAfterBootstrap": {"type": "boolean"},
        "allowedServices": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "profiles": {"type": "object"}
      }
    },
    "ci": {"type": "object"}
  }
}
